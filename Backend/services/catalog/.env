# ─────────────────────────────────────────────
#  novaXchange — Catalog Service
#  Copy this file to .env and fill in the values
#  Never commit .env to git
# ─────────────────────────────────────────────

# ── App ───────────────────────────────────────
APP_ENV=development           # development | production
APP_PORT=8001
BASE_URL=http://localhost:8001 # https://novaxchange.xyz in production

# ── MongoDB ───────────────────────────────────
# Local (VPS or dev machine)
MONGO_URI=mongodb://localhost:27017/novaxchange
MONGO_DB_NAME=novaxchange

# ── Cloudflare R2  (Primary image store) ──────
# Get these from: Cloudflare Dashboard → R2 → Manage API tokens

R2_ACCOUNT_ID=47ba79a726959f21e3d7c0d7a76a14ff
R2_ACCESS_KEY_ID=8d88b3c05d0de6b92a6ed2c460729cf1
R2_SECRET_ACCESS_KEY=e0627e1a69ab13595579fe9f6a1b268f78fcddf5adc41043ae0fda644ffcfe7b
R2_BUCKET_NAME=storage-bucket

# Public URL for your bucket — enable in R2 bucket settings → Public access
R2_PUBLIC_URL=https://pub-5b965219b7644024b0894c7005c8c3e2.r2.dev

# ── Local disk  (VPS backup — currently commented out in storage.py) ──
# Uncomment the local write block in storage.py when you want dual-write
LOCAL_UPLOAD_DIR=/var/www/novaxchange/uploads/products
# In dev you can use a relative path:
# LOCAL_UPLOAD_DIR=./uploads/products

# ── Image storage mode ────────────────────────
# Controls which URL is returned to clients
# "r2"    → serve from R2 CDN (default)
# "local" → serve from VPS Nginx (failover)
IMAGE_SOURCE=r2

# ── JWT — admin sessions ───────────────────────
# Deliberately separate from CUSTOMER_JWT_SECRET below — a customer
# token must never be valid for admin routes, or vice versa.
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 hours

# ── JWT — customer sessions ────────────────────
CUSTOMER_JWT_SECRET=change_this_to_a_different_long_random_string_min_32_chars
CUSTOMER_JWT_EXPIRE_MINUTES=43200  # 30 days

# ── Supabase (Google sign-in for customers) ────
# Get these from: Supabase Dashboard → Project Settings → API
# Leave blank to disable "Continue with Google" (email/password still works).
SUPABASE_URL=https://vrepvomfgykllkdidkmy.supabase.co
SUPABASE_KEY=sb_publishable_BqHVxV2YKYWxbM7HY6KGFw_1dbFrzd6

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,https://novaxchange.xyz,https://admin.novaxchange.xyz

# ── Fixed admin account ───────────────────────
# The backend can bootstrap a verified default admin from these values.
# Either set ADMIN_PASSWORD (simple) or ADMIN_PASSWORD_HASH (bcrypt hash).
#ADMIN_EMAIL=admin@novaxchange.xyz
ADMIN_EMAIL=admin@novaxchange.xyz
ADMIN_PASSWORD=!@#jj$kaliw
# ADMIN_PASSWORD_HASH=$2b$12$placeholder_replace_this_with_real_hash

# ── Gmail SMTP for admin verification emails ──
# Use a Google account with 2-Step Verification enabled.
# Create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=admin@novaxchange.xyz
SMTP_PASSWORD=!@#jj$kaliW1
SMTP_FROM_EMAIL=admin@novaxchange.xyz
SMTP_USE_TLS=true