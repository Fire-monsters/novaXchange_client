# ─────────────────────────────────────────────
# novaXchange — Catalog Service
# Copy this file to .env and fill in the values.
# Never commit .env to Git.
# ─────────────────────────────────────────────

# App
APP_ENV=development
APP_PORT=8001
BASE_URL=http://localhost:8001

# MongoDB
MONGO_URI=mongodb://localhost:27017/novaxchange
MONGO_DB_NAME=novaxchange

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=novaxchange-products
R2_PUBLIC_URL=https://your-public-bucket-url.example.com

# Local image storage
LOCAL_UPLOAD_DIR=./uploads/products
IMAGE_SOURCE=r2

# Admin sessions
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Customer sessions — must differ from JWT_SECRET
CUSTOMER_JWT_SECRET=change_this_to_a_different_long_random_string_min_32_chars
CUSTOMER_JWT_EXPIRE_MINUTES=43200

# Supabase Google sign-in; leave blank to disable
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Fixed admin account
ADMIN_EMAIL=admin@example.com
ADMIN_WHATSAPP=256700000000
ADMIN_PASSWORD=replace_with_a_strong_password
# ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash
ADMIN_ACCOUNTS_FILE=./data/admin_accounts.json

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=admin@example.com
SMTP_PASSWORD=replace_with_an_smtp_app_password
SMTP_FROM_EMAIL=admin@example.com
SMTP_USE_TLS=true
